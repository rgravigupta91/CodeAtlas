# Copy this file to .env and fill in your values

# ── LLM Configuration ──────────────────────────────────────────────────────
# API key for your LLM provider (OpenAI or LiteLLM proxy)
API_KEY=your-api-key-here

# Model name
# Examples: gpt-4o-mini, gpt-4o, anthropic--claude-3-5-sonnet
MODEL=gpt-4o-mini

# Base URL — leave blank for direct OpenAI
# Set this if using a LiteLLM proxy or custom endpoint
# BASE_URL=http://localhost:6655/litellm/v1
